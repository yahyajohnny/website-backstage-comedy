# Backstage Comedy Night – Apache config
Options -Indexes

# Prefer PHP over static HTML when both exist
DirectoryIndex index.php index.html

# HTTPS + www (single hop via combined conditions where possible)
RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Force www
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Event detail pages: /termine/{slug}/ → termine/event.php?slug=
RewriteRule ^termine/([a-z0-9\-]+)/?$ termine/event.php?slug=$1 [L,QSA]

# Trailing slash for directories
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.+[^/])$ /$1/ [R=301,L]

# Custom 404

# Serve PHP backends for legacy .html URLs
RewriteRule ^galerie\.html$ galerie.php [L]
RewriteRule ^impressum\.html$ impressum.php [L]
RewriteRule ^datenschutz\.html$ datenschutz.php [L]

ErrorDocument 404 /404.html

# Protect internals
RewriteRule ^lib/ - [F,L]
RewriteRule ^cache/ - [F,L]
RewriteRule ^cron/ - [F,L]
RewriteRule ^includes/ - [F,L]

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/avif "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType font/woff2 "access plus 365 days"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
